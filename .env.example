# Local development only. Replace the password before use.
AFS_POSTGRES_DB=afs_dev
AFS_POSTGRES_USER=afs
AFS_POSTGRES_PASSWORD=replace-with-a-long-random-local-password
AFS_POSTGRES_PORT=5432
AFS_DATABASE_URL=postgresql+psycopg://afs:replace-with-a-long-random-local-password@localhost:5432/afs_dev
AFS_ENV=development
AFS_API_PREFIX=/api/v1

# Optional transactional outbox webhook publisher
AFS_OUTBOX_WEBHOOK_URL=
AFS_OUTBOX_WEBHOOK_TOKEN=
AFS_OUTBOX_PUBLISHER_ID=afs-outbox-publisher-01
# Optional OpenAI-compatible model endpoint. Leave unset for offline/test mode.
AFS_MODEL_BASE_URL=https://api.openai.com/v1
AFS_MODEL_API_KEY=

# PostgreSQL integration tests (set to the same isolated test database)
AFS_TEST_POSTGRES_URL=postgresql+psycopg://afs:replace-with-a-long-random-local-password@localhost:5432/afs_test
